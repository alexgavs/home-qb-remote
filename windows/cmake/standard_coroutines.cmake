# These plugin releases request C++20 but also pass the obsolete /await flag.
# Their C++/WinRT headers choose std::coroutine when __cpp_lib_coroutine is
# defined. Include <coroutine> before those headers instead of silencing STL1011.
function(home_qb_use_standard_coroutines target_name)
  if(MSVC AND TARGET ${target_name})
    get_target_property(plugin_options ${target_name} COMPILE_OPTIONS)
    if(plugin_options)
      list(FILTER plugin_options EXCLUDE REGEX "^/await(:strict)?$")
      set_property(TARGET ${target_name} PROPERTY COMPILE_OPTIONS "${plugin_options}")
    endif()
    target_compile_features(${target_name} PRIVATE cxx_std_20)
    set_target_properties(${target_name} PROPERTIES
      CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
    target_compile_options(${target_name} PRIVATE /FIcoroutine)
  endif()
endfunction()

# local_auth_windows 2.0.2 also uses a TS-only plain return in a coroutine.
# Adapt a generated build-directory copy; never modify the pub cache.
function(home_qb_fix_local_auth_coroutine_return)
  if(NOT MSVC OR NOT TARGET local_auth_windows_plugin)
    return()
  endif()
  get_target_property(plugin_dir local_auth_windows_plugin SOURCE_DIR)
  get_target_property(plugin_sources local_auth_windows_plugin SOURCES)
  set(original "${plugin_dir}/local_auth_plugin.cpp")
  file(READ "${original}" source)
  string(FIND "${source}" "    return consent_result;" legacy_return)
  if(legacy_return EQUAL -1)
    string(FIND "${source}" "co_return consent_result;" fixed_return)
    if(fixed_return EQUAL -1)
      message(FATAL_ERROR "local_auth_windows coroutine source changed; review compatibility patch")
    endif()
    return()
  endif()
  string(REPLACE "    return consent_result;" "    co_return consent_result;" source "${source}")
  set(patched_dir "${CMAKE_CURRENT_BINARY_DIR}/home_qb_plugin_compat")
  file(MAKE_DIRECTORY "${patched_dir}")
  set(patched "${patched_dir}/local_auth_plugin.cpp")
  file(WRITE "${patched}" "${source}")
  set(updated_sources)
  set(replaced FALSE)
  foreach(source_file IN LISTS plugin_sources)
    if(source_file STREQUAL "local_auth_plugin.cpp" OR source_file STREQUAL original)
      list(APPEND updated_sources "${patched}")
      set(replaced TRUE)
    else()
      list(APPEND updated_sources "${source_file}")
    endif()
  endforeach()
  if(NOT replaced)
    message(FATAL_ERROR "local_auth_windows translation unit changed; review compatibility patch")
  endif()
  set_property(TARGET local_auth_windows_plugin PROPERTY SOURCES "${updated_sources}")
  target_include_directories(local_auth_windows_plugin PRIVATE "${plugin_dir}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
endfunction()
